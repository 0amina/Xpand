{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && tsc -p tsconfig.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/tesseract.js*/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
