# ---------------------------------------------------------------------------
# Xpand backend — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# All variables are validated at startup by src/config/env.ts (Zod). If any
# required value is missing or malformed, the server refuses to boot.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# NOTE: the spec's `xpand/admin` role does not authenticate on the local server (only the
# `xpand` DATABASE exists), so we connect as the `postgres` superuser for now. Swap in a
# dedicated least-privilege role when one is created. URL-encode special chars in the password.
#
# HOSTED (Supabase): use the **transaction pooler** string — port 6543, not 5432 — and keep the
# two query parameters. Each serverless instance opens its own pool, so direct connections run
# the project out of them within minutes of real traffic:
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# `pgbouncer=true` stops Prisma using prepared statements, which a transaction-mode pooler cannot
# keep across statements; `connection_limit=1` keeps one instance from hoarding the pool.
# The port-5432 "direct connection" string is for migrations and `prisma db pull`, not runtime.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/xpand"

# Port the HTTP server listens on.
PORT=3000

# Runtime environment: development | test | production
# Controls log formatting (pretty vs JSON) among other things.
NODE_ENV=development

# Comma-separated list of allowed CORS origins (no spaces required).
# Example: https://web.telegram.org,http://localhost:5173
# Leave empty to allow no cross-origin browsers (same-origin / server-to-server only).
CORS_ORIGINS=http://localhost:5173

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather (looks like 8123456789:AAG...). It does two jobs:
#   1. verifies Mini App initData signatures — i.e. it IS the authentication key;
#   2. lets the bot receive commands.
# Optional in development (the bot stays off and the x-telegram-id dev header is
# accepted instead). REQUIRED when NODE_ENV=production — the server refuses to boot
# without it, because there would be no way to authenticate anyone.
# An empty value is treated as unset.
TELEGRAM_BOT_TOKEN=

# How the bot receives updates:
#   polling  — we ask Telegram for updates. No public URL needed. Right for local dev.
#   webhook  — Telegram POSTs to BOT_WEBHOOK_URL + /telegram/webhook. Right for production.
#   off      — no bot at all.
# Defaults to `webhook` on Vercel, `polling` elsewhere when a token is set, `off` when it isn't.
# NOTE: only ONE process may poll a given token. Two make Telegram return 409 and the
# two instances steal each other's updates.
# Webhook mode does NOT register itself on a serverless host — a cold start per burst of traffic
# would re-register on each one. Run `npm run bot:register` once after deploying, and again
# whenever BOT_WEBHOOK_URL changes.
BOT_MODE=

# Public HTTPS base URL of THIS backend. Only used when BOT_MODE=webhook.
# Example: https://api.xpand.example.com
BOT_WEBHOOK_URL=

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header, so
# nobody else can POST fake updates to the webhook. Min 16 chars.
# Leave empty and one is derived from the bot token — stable across restarts, which
# matters if you run more than one instance.
BOT_WEBHOOK_SECRET=

# Public HTTPS URL of the Mini App frontend (the xpandFront deployment).
# Used to build the bot's "Open app" buttons and the ☰ menu button. Telegram REJECTS
# non-HTTPS URLs, so http://localhost will not work — use a tunnel for local testing
# (see README → "Testing the bot locally").
# Leave empty and the bot still answers, just without app buttons.
MINI_APP_URL=

# ---------------------------------------------------------------------------

# Starting cash balance used by the cash-position report. The DB has no field for it, so it
# lives here. Defaults to 0; can be overridden per request via ?openingBalance=.
OPENING_BALANCE=0

# ---------------------------------------------------------------------------
# Invoices, OCR, and file storage
# ---------------------------------------------------------------------------

# Hard ceiling on a single invoice upload. Phone photos are typically 2-6 MB. Max 50.
MAX_UPLOAD_MB=10

# Tesseract languages, `+`-joined. Invoices here are overwhelmingly French; English catches the
# occasional bilingual header. Each language adds to worker warm-up time.
OCR_LANGS=fra+eng

# Accept uploads but skip OCR. Invoices then land in FAILED with an explanatory message and the
# user fills the draft by hand — the verify-then-save flow is identical either way, since OCR
# only ever pre-fills a form nobody is forced to trust.
OCR_ENABLED=true

# Run OCR *inside* the upload request instead of after the response.
# Empty = on when running on Vercel, off otherwise — which is almost always what you want, so
# leave it alone unless you are reproducing serverless behaviour locally.
# Serverless hosts freeze the instance the moment a response is written, so a background pipeline
# is killed partway through and the invoice never leaves PENDING. The cost of the fix is a slow
# upload (a few seconds per page) in exchange for a response that already carries the draft.
OCR_SYNC=

# Where uploaded invoice files are written by the `disk` driver. Relative paths resolve against
# the process CWD; the directory is created on first upload. Ignored by the `supabase` driver.
UPLOAD_DIR=./uploads/invoices

# Where Tesseract caches its *.traineddata. The first OCR run downloads ~6 MB; afterwards it runs
# offline. On Vercel this defaults under /tmp, the only writable path — and because /tmp does not
# survive, each cold start pays the download again.
TESSDATA_DIR=./.tessdata

# Which backend holds invoice files: disk | supabase
# Empty = supabase when SUPABASE_URL is set, disk otherwise. Set it to `disk` explicitly to keep
# files local while still talking to the hosted database.
# The disk driver cannot work on a serverless host — the filesystem does not survive the
# invocation — so the server refuses to boot in that combination rather than losing uploads.
STORAGE_DRIVER=

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Supabase dashboard → Project Settings → API → Project URL.
SUPABASE_URL=

# Supabase `service_role` key — Project Settings → API.
# This key BYPASSES row-level security. It is a server secret: never expose it to the browser,
# never put it in a VITE_ variable, never commit it. Only `invoices/storage.ts` reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket holding invoice files. Create it **private** (Storage → New bucket, "Public" unchecked):
# files are served through `GET /api/invoices/:id/file` so the auth middleware sits in front of
# them, and a public bucket would put every receipt behind a guessable URL instead.
SUPABASE_STORAGE_BUCKET=invoices
