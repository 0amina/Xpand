# ---------------------------------------------------------------------------
# Xpand backend — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# All variables are validated at startup by src/config/env.ts (Zod). If any
# required value is missing or malformed, the server refuses to boot.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# NOTE: the spec's `xpand/admin` role does not authenticate on the local server (only the
# `xpand` DATABASE exists), so we connect as the `postgres` superuser for now. Swap in a
# dedicated least-privilege role when one is created. URL-encode special chars in the password.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/xpand"

# Port the HTTP server listens on.
PORT=3000

# Runtime environment: development | test | production
# Controls log formatting (pretty vs JSON) among other things.
NODE_ENV=development

# Comma-separated list of allowed CORS origins (no spaces required).
# Example: https://web.telegram.org,http://localhost:5173
# Leave empty to allow no cross-origin browsers (same-origin / server-to-server only).
CORS_ORIGINS=http://localhost:5173

# Pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather (looks like 8123456789:AAG...). It does two jobs:
#   1. verifies Mini App initData signatures — i.e. it IS the authentication key;
#   2. lets the bot receive commands.
# Optional in development (the bot stays off and the x-telegram-id dev header is
# accepted instead). REQUIRED when NODE_ENV=production — the server refuses to boot
# without it, because there would be no way to authenticate anyone.
# An empty value is treated as unset.
TELEGRAM_BOT_TOKEN=

# How the bot receives updates:
#   polling  — we ask Telegram for updates. No public URL needed. Right for local dev.
#   webhook  — Telegram POSTs to BOT_WEBHOOK_URL + /telegram/webhook. Right for production.
#   off      — no bot at all.
# Defaults to `polling` when a token is set, `off` when it isn't.
# NOTE: only ONE process may poll a given token. Two make Telegram return 409 and the
# two instances steal each other's updates.
BOT_MODE=

# Public HTTPS base URL of THIS backend. Only used when BOT_MODE=webhook.
# Example: https://api.xpand.example.com
BOT_WEBHOOK_URL=

# Shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header, so
# nobody else can POST fake updates to the webhook. Min 16 chars.
# Leave empty and one is derived from the bot token — stable across restarts, which
# matters if you run more than one instance.
BOT_WEBHOOK_SECRET=

# Public HTTPS URL of the Mini App frontend (the xpandFront deployment).
# Used to build the bot's "Open app" buttons and the ☰ menu button. Telegram REJECTS
# non-HTTPS URLs, so http://localhost will not work — use a tunnel for local testing
# (see README → "Testing the bot locally").
# Leave empty and the bot still answers, just without app buttons.
MINI_APP_URL=

# ---------------------------------------------------------------------------

# Starting cash balance used by the cash-position report. The DB has no field for it, so it
# lives here. Defaults to 0; can be overridden per request via ?openingBalance=.
OPENING_BALANCE=0
