{
  "compilerOptions": {
    /* We target the current Node LTS (v20+), which supports modern ES features natively. */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* ESM everywhere. NodeNext makes tsc resolve modules the same way Node does at runtime,
       which is why relative imports must carry explicit .js extensions (see README). */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "outDir": "./dist",
    "rootDir": "./src",

    /* --- Strictness: every strict flag on, plus the extras the project asked for. --- */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,

    /* Interop + emit quality of life. */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    "declaration": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
