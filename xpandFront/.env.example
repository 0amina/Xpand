# Copy to `.env` and adjust. Only variables prefixed with VITE_ reach the browser bundle.
# NOTE: everything here is public — it ships inside the JS bundle. Never put secrets in it.

# Base URL of the Xpand backend. Leave as-is for a local backend on the default port.
VITE_API_BASE_URL=http://localhost:3000

# --- Development only -------------------------------------------------------------------
# Outside Telegram there is no initData, so there is no user id. Set one here to skip the
# dev sign-in screen and boot straight into the app as that user.
#
# The id must already exist in the backend, or be creatable via POST /api/users/login — the
# app performs that upsert automatically on boot. Ignored when running inside Telegram.
VITE_DEV_TELEGRAM_ID=
VITE_DEV_FIRST_NAME=Dev
